{
  "name": "document-extraction",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "benchmark:global-store": "bun scripts/benchmarkGlobalStore.ts",
    "benchmark:bun-runtime": "bun run --cwd backend benchmark:bun-runtime",
    "benchmark:loopback-saturation": "bun run --cwd backend benchmark:loopback-saturation",
    "build": "bun run --cwd frontend build",
    "check:agent": "bun backend/scripts/runAgentChecks.ts",
    "ci": "bun run ci:quality && bun run test:e2e",
    "ci:quality": "bun run typecheck && bun run lint && bun run test && bun run --cwd frontend test:coverage && bun run build",
    "dev": "bun --watch backend/src/server.ts",
    "dev:frontend": "bun run --cwd frontend dev",
    "migrate": "bun run --cwd backend migrate",
    "package:diff-evidence": "bun scripts/generatePackageDiffEvidence.ts",
    "package:hygiene": "bun scripts/packageHygiene.ts",
    "package:release": "bun scripts/packageRelease.ts",
    "prototype:throughput": "bun backend/benchmarks/throughput.ts",
    "prototype:layouts": "bun run --cwd frontend dev --host 127.0.0.1 --port 5173 --open '/?prototype=layouts&variant=A1'",
    "start": "bun backend/src/server.ts",
    "lint": "bunx eslint .",
    "test": "bun run --cwd backend test && bun run --cwd frontend test",
    "test:e2e": "bun run build && bun test e2e/support/browserEvidence.bun.test.ts && playwright test",
    "test:installer": "bun test scripts/installer.bun.test.ts --timeout 180000",
    "typecheck": "bun run --cwd backend typecheck && bun run typecheck:e2e && bun run typecheck:installer",
    "typecheck:installer": "bunx tsc --noEmit -p scripts/tsconfig.installer.json",
    "typecheck:e2e": "bunx tsc --noEmit -p e2e/tsconfig.json"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "bun-types": "1.4.2",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.60.1"
  }
}
