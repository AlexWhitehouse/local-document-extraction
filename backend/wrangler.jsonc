{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "imageextraction-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-04-14",
	"compatibility_flags": [
		"nodejs_als"
	],
	"workers_dev": false,
	"routes": [
		{
			"pattern": "extract.t3m.uk",
			"custom_domain": true,
		},
	],
	"assets": {
		"directory": "../frontend/dist",
		"binding": "ASSETS",
		"run_worker_first": true,
		"not_found_handling": "single-page-application",
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "imageextraction-db",
			"database_id": "694a4504-d58a-4558-babd-715460b61fb0",
			"migrations_dir": "migrations",
		},
	],
	"r2_buckets": [
		{
			"binding": "IMAGES_BUCKET",
			"bucket_name": "imageextraction-images",
		},
	],
	"queues": {
		"producers": [
			{
				"binding": "JOBS_QUEUE",
				"queue": "imageextraction-jobs",
			},
		],
		"consumers": [
			{
				"queue": "imageextraction-jobs",
				"max_batch_size": 5,
				"max_batch_timeout": 3,
				"max_retries": 5,
			},
		],
	},
	"ai": {
		"binding": "AI",
	},
	"vars": {
		"AI_GATEWAY_ACCOUNT_ID": "3b2de301f6196275cb705b1335218e95",
		"AI_GATEWAY_ID": "default",
		"AI_GATEWAY_PROVIDER": "google-ai-studio",
		"AI_MODEL": "google/gemini-3-flash",
		"AI_GATEWAY_ROUTE": "default",
		"BETTER_AUTH_TRUSTED_ORIGINS": "https://extract.t3m.uk,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8787",
		"GOOGLE_CLIENT_ID": "1082322177224-edqh57bijki1hku07sqdp91s3j0um4q6.apps.googleusercontent.com",
		"MAX_IMAGE_BYTES": "10485760",
	},
}