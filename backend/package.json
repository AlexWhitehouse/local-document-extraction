{
  "name": "imageextraction",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "test": "bunx vitest run --exclude '**/*.bun.test.ts' && bun test $(find src -name '*.bun.test.ts' -print)",
    "typecheck": "bunx tsc --noEmit",
    "migrate": "bun src/migrate.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/busboy": "1.5.4",
    "@types/node": "^25.6.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.2",
    "better-auth": "^1.6.6",
    "busboy": "1.6.0",
    "exceljs": "^4.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.1.200"
  }
}
