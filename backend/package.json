{
  "name": "imageextraction",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "wrangler dev --persist-to ./.wrangler/state",
    "deploy": "wrangler deploy",
    "deploy:prod": "npm run build --prefix ../frontend && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply imageextraction-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply imageextraction-db --remote"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^5.6.3",
    "wrangler": "^4.87.0"
  },
  "dependencies": {
    "better-auth": "^1.6.6"
  }
}
