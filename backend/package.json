{
  "name": "imageextraction",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "wrangler dev --persist-to ./.wrangler/state",
    "test": "vitest run",
    "preflight:prod": "node scripts/productionPreflight.mjs",
    "deploy": "npm run deploy:prod",
    "deploy:prod": "npm run preflight:prod && wrangler deploy --secrets-file ../.vars",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply document-extraction-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply document-extraction-db --remote"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.5",
    "wrangler": "^4.98.0"
  },
  "dependencies": {
    "better-auth": "^1.6.6",
    "pdf-lib": "^1.17.1"
  }
}
