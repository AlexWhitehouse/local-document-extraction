{
  "name": "imageextraction",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --persist-to ./.wrangler/state",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply imageextraction-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply imageextraction-db --remote"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "wrangler": "^4.38.0"
  }
}
