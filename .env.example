# Copy to .env for source installs. Installer configuration lives in config.env.
# Restart after changes. Full reference: docs/configuration.md
# No model gateway keys go here: configure them separately in each Workspace.

# Network and paths (paths below are optional overrides).
HOST=127.0.0.1
PORT=8787
# BETTER_AUTH_URL=http://127.0.0.1:8787
# DOCUMENT_EXTRACTION_STATE_DIR=/absolute/private/path/document-extraction
# DOCUMENT_EXTRACTION_ASSETS_DIR=/absolute/path/to/frontend/dist
# DEV_API_ORIGIN=http://127.0.0.1:8787

# Account access. Set administrator emails BEFORE creating those accounts.
DOCUMENT_EXTRACTION_ADMIN_EMAILS=
AUTH_EMAIL_PASSWORD_ENABLED=true
AUTH_GOOGLE_ENABLED=false
AUTH_SIGNUP_ENABLED=true
# Optional: require an email verification link before sign-in.
AUTH_REQUIRE_EMAIL_VERIFICATION=false
AUTH_TRUSTED_ORIGINS=
# Trust IP headers only behind a proxy which overwrites them and blocks direct access.
AUTH_TRUSTED_IP_HEADERS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Default local mode writes verification/reset links to private files and logs.
# For delivery, set cloudflare and use a sender from your onboarded domain.
EMAIL_PROVIDER=local
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME="Document Extraction"
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=

# Payloads: source default 10 MiB; JSON default 1 MiB.
# Upload reservation must allow the source limit PLUS 32768 bytes.
MAX_SOURCE_FILE_BYTES=10485760
MAX_JSON_REQUEST_BYTES=1048576
SUBMISSION_MAX_CONCURRENCY=8
SUBMISSION_MAX_RESERVED_BYTES=134217728

# Model requests and background processing.
MODEL_GATEWAY_REQUEST_TIMEOUT_MS=300000
EXTRACTION_RETRY_DELAY_MS=1000
EXTRACTION_MAX_CONCURRENCY=8
EXTRACTION_MAX_BUFFERED=10000
EXTRACTION_RECONCILE_INTERVAL_MS=60000
EXTRACTION_ADAPTIVE_CONCURRENCY=true
EXTRACTION_MAX_CONCURRENCY_LIMIT=32

# Ratios use physical host capacity, not a shared budget with a local model server.
LOCAL_CPU_LIMIT_RATIO=0.85
LOCAL_MEMORY_LIMIT_RATIO=0.8
# Optional lower model preparation budget, in bytes; RAM-derived by default.
# MODEL_PREPARATION_MAX_BYTES=268435456
MEMORY_PRESSURE_LARGE_SUBMISSION_BYTES=4194304
LOCAL_DISK_RESERVE_BYTES=1073741824

# Retention and shutdown. Completed source binaries are removed automatically.
SOURCE_RETENTION_SWEEP_INTERVAL_MS=3600000
FAILED_SOURCE_RETENTION_MS=604800000
LOCAL_SHUTDOWN_TIMEOUT_MS=10000
LOCAL_ANALYTICS_ENABLED=true
